# Database Connection (PostgreSQL or SQLite fallback)
# PostgreSQL example: postgresql://postgres:password@localhost:5432/finguard
# SQLite default: sqlite:///./finguard.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finguard

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

